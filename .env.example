# ==============================================================================
# MyCropDiary Backend - Environment Configuration Template (.env.example)
# ==============================================================================
# Hướng dẫn:
# 1. Sao chép file này thành .env ở thư mục gốc dự án:
#    cp .env.example .env (hoặc copy-paste trên Windows)
# 2. Điền các giá trị thực tế của môi trường local vào file .env
# 3. File .env đã được khai báo trong .gitignore, tuyệt đối không commit .env lên Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cấu hình Server & CORS
# ------------------------------------------------------------------------------
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Cấu hình Bảo mật JWT (JSON Web Token)
# Secret key dùng ký token HMAC-SHA512 (BẮT BUỘC tối thiểu 64 ký tự / 512 bits)
# ------------------------------------------------------------------------------
JWT_SECRET=MyCropDiarySuperSecretKeyForJWTAuthentication2026SEP490FPTUniversityVietnam!!
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000

# ------------------------------------------------------------------------------
# 3. Cấu hình Xác thực OTP qua Email
# ------------------------------------------------------------------------------
OTP_EXPIRATION_MINUTES=15
OTP_LENGTH=6

# ------------------------------------------------------------------------------
# 4. Cấu hình Cơ sở dữ liệu Microsoft SQL Server (Profile: sqlserver)
# ------------------------------------------------------------------------------
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=MyCropDiary;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=YourStrongPassword!123

# ------------------------------------------------------------------------------
# 5. Cấu hình Gửi Email SMTP (Xác thực đăng ký, quên mật khẩu)
# Local mặc định trỏ localhost:1025 (nếu không có MailHog thì AuthService sẽ ghi OTP ra log)
# Khi cần gửi Gmail thật:
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your-email@gmail.com
#   MAIL_PASSWORD=your-google-app-password (mật khẩu ứng dụng 16 chữ cái)
#   MAIL_AUTH=true
#   MAIL_STARTTLS_ENABLE=true
# ------------------------------------------------------------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS_ENABLE=false
