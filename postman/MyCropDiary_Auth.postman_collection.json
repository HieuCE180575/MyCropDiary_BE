        {
          "name": "1.3 Lấy mã OTP tự động từ MailHog",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Kết nối thành công tới MailHog (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const resJson = pm.response.json();",
                  "let messages = [];",
                  "if (Array.isArray(resJson)) {",
                  "    messages = resJson;",
                  "} else if (resJson && Array.isArray(resJson.items)) {",
                  "    messages = resJson.items;",
                  "} else if (resJson && Array.isArray(resJson.messages)) {",
                  "    messages = resJson.messages;",
                  "}",
                  "",
                  "pm.test('MailHog có danh sách email đã nhận', function () {",
                  "    pm.expect(messages.length).to.be.greaterThan(0);",
                  "});",
                  "",
                  "const targetEmail = pm.collectionVariables.get('email');",
                  "const matchedMsg = messages.find(m => {",
                  "    const toHeader = m.Content && m.Content.Headers && m.Content.Headers.To ? JSON.stringify(m.Content.Headers.To) : '';",
                  "    const toList = m.To ? JSON.stringify(m.To) : '';",
                  "    return toHeader.includes(targetEmail) || toList.includes(targetEmail);",
                  "}) || messages[0];",
                  "",
                  "pm.test('Trích xuất thành công mã OTP 6 chữ số từ email', function () {",
                  "    pm.expect(matchedMsg, 'Không tìm thấy email tương ứng trong MailHog').to.not.be.undefined;",
                  "    const body = matchedMsg.Content && matchedMsg.Content.Body ? matchedMsg.Content.Body : '';",
                  "    const match = body.match(/Mã xác thực \\(OTP\\) của bạn là:\\s*(\\d{6})/i) || body.match(/(\\d{6})/);",
                  "    pm.expect(match, 'Không trích xuất được 6 số OTP trong nội dung').to.not.be.null;",
                  "    const otpCode = match[1];",
                  "    pm.collectionVariables.set('otp', otpCode);",
                  "    if (pm.environment.name) {",
                  "        pm.environment.set('otp', otpCode);",
                  "    }",
                  "    console.log('==> [Happy Path] Đã bắt được mã OTP:', otpCode);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{mailhogUrl}}/api/v2/messages?limit=10",
              "host": [
                "{{mailhogUrl}}"
              ],
