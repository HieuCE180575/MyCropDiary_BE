  "item": [
    {
      "name": "01. Flow Đăng ký & Kích hoạt (Happy Path)",
      "description": "Kiểm thử luồng chuẩn từ khi tạo tài khoản PENDING, chặn đăng nhập trước khi xác thực, trích xuất OTP tự động từ MailHog, xác thực OTP thành công và đăng nhập.",
      "item": [
        {
          "name": "1.1 Đăng ký tài khoản mới (Register)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Tự động tạo email ngẫu nhiên để mọi lần chạy test đều độc lập",
                  "const timestamp = Date.now();",
                  "const dynamicEmail = `farmer_${timestamp}@mycropdiary.com`;",
                  "pm.collectionVariables.set('email', dynamicEmail);",
                  "console.log('==> [Happy Path] Đang đăng ký với email mới:', dynamicEmail);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code là 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Thời gian phản hồi nhanh (< 2000ms)', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test('ApiResponse trả về success = true và thông điệp chuẩn', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.be.an('object');",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.message).to.eql('Đăng ký thành công. Vui lòng kiểm tra email để nhận mã OTP xác thực.');",
                  "    pm.expect(json.data).to.be.an('object');",
                  "    pm.expect(json.data.email).to.eql(pm.collectionVariables.get('email'));",
                  "    pm.expect(json.timestamp).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"{{fullName}}\",\n  \"email\": \"{{email}}\",\n  \"phoneNumber\": \"{{phoneNumber}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            }
          }
        },
