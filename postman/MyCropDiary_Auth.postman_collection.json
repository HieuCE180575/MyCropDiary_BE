                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "1.4 Xác thực OTP thành công (Verify OTP)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code là 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Tài khoản đã được kích hoạt thành công', function () {",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.message).to.eql('Xác thực OTP thành công. Tài khoản đã được kích hoạt.');",
                  "});",
                  "",
                  "pm.test('Nhận AuthResponse chứa JWT Token và thông tin User', function () {",
                  "    pm.expect(json.data).to.be.an('object');",
                  "    pm.expect(json.data.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.data.refreshToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.data.tokenType).to.eql('Bearer');",
                  "    pm.expect(json.data.email).to.eql(pm.collectionVariables.get('email'));",
                  "    pm.expect(json.data.fullName).to.eql(pm.collectionVariables.get('fullName'));",
                  "    pm.expect(json.data.role).to.be.a('string');",
                  "",
                  "    // Lưu token cho các API sau",
                  "    pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "    if (pm.environment.name) {",
                  "        pm.environment.set('accessToken', json.data.accessToken);",
                  "        pm.environment.set('refreshToken', json.data.refreshToken);",
                  "    }",
                  "    console.log('==> [Happy Path] Token đã lưu thành công.');",
                  "});",
                  "",
                  "pm.test('Access Token có cấu trúc JWT hợp lệ (Header.Payload.Signature)', function () {",
                  "    const parts = json.data.accessToken.split('.');",
                  "    pm.expect(parts.length).to.eql(3);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}",
              "options": {
