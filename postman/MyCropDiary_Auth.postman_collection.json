{
  "info": {
    "name": "MyCropDiary Auth - Register & OTP",
    "description": "Postman collection cho chức năng đăng ký, gửi lại OTP và xác thực OTP của MyCropDiary Backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "fullName",
      "value": "Nguyen Van A",
      "type": "string"
    },
    {
      "key": "email",
      "value": "testuser@example.com",
      "type": "string"
    },
    {
      "key": "phoneNumber",
      "value": "0901234567",
      "type": "string"
    },
    {
      "key": "password",
      "value": "Abc12345",
      "type": "string"
    },
    {
      "key": "otp",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Register account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"{{fullName}}\",\n  \"email\": \"{{email}}\",\n  \"phoneNumber\": \"{{phoneNumber}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "register"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 or 200\", function () {\n  pm.expect(pm.response.code).to.be.oneOf([200, 201]);\n});\n",
              "const json = pm.response.json();\n",
              "console.log('Register response:', json);\n"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Resend OTP",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/resend-otp?email={{email}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "resend-otp"
          ],
          "query": [
            {
              "key": "email",
              "value": "{{email}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Resend OTP success\", function () {\n  pm.expect(pm.response.code).to.be.oneOf([200, 201]);\n});\n"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Get OTP from MailHog",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8025/api/v2/messages?limit=10",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8025",
          "path": [
            "api",
            "v2",
            "messages"
          ],
          "query": [
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"MailHog returns messages\", function () {\n  pm.response.to.have.status(200);\n});\n",
              "const messages = pm.response.json();\n",
              "if (Array.isArray(messages) && messages.length > 0) {\n  const latest = messages[0];\n  const body = latest.Content && latest.Content.Body ? latest.Content.Body : (latest.content && latest.content.body ? latest.content.body : '');\n  const match = body.match(/Mã xác thực \\(OTP\\) của bạn là:\\s*(\\d{6})/i) || body.match(/(\\d{6})/);\n  if (match) {\n    pm.environment.set('otp', match[1]);\n    console.log('Captured OTP:', match[1]);\n  } else {\n    console.log('Could not parse OTP from email body:', body);\n  }\n} else {\n  console.log('No messages found in MailHog');\n}\n"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Verify OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/verify-otp",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "verify-otp"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Verify OTP success\", function () {\n  pm.expect(pm.response.code).to.be.oneOf([200, 201]);\n});\n",
              "const json = pm.response.json();\n",
              "if (json && json.data) {\n  if (json.data.accessToken) pm.environment.set('accessToken', json.data.accessToken);\n  if (json.data.refreshToken) pm.environment.set('refreshToken', json.data.refreshToken);\n}\n",
              "console.log('Verify OTP response:', json);\n"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. Login with email + password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Login success\", function () {\n  pm.response.to.have.status(200);\n});\n",
              "const json = pm.response.json();\n",
              "if (json && json.data) {\n  if (json.data.accessToken) pm.environment.set('accessToken', json.data.accessToken);\n  if (json.data.refreshToken) pm.environment.set('refreshToken', json.data.refreshToken);\n}\n",
              "console.log('Login response:', json);\n"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
