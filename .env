# ==============================================================================
# MyCropDiary Backend - Local Environment Configuration (.env)
# ==============================================================================
# File này chứa các biến nhạy cảm cho môi trường chạy local.
# Đã được bỏ qua bởi Git (.gitignore).
# ==============================================================================

# Server & CORS
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Spring Profiles: sqlserver (kết nối Microsoft SQL Server) hoặc local (chạy H2 in-memory)
SPRING_PROFILES_ACTIVE=sqlserver

# JWT Security (HMAC-SHA512: >= 64 chars)
JWT_SECRET=MyCropDiarySuperSecretKeyForJWTAuthentication2026SEP490FPTUniversityVietnam!!
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000

# OTP Configuration
OTP_EXPIRATION_MINUTES=15
OTP_LENGTH=6

# SQL Server Database Configuration
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=MyCropDiary;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=Leminhvip1

